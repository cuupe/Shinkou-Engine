{
  "version": 6,
  "configurePresets": [
    {
      "name": "mingw-debug",
      "displayName": "MinGW Debug",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/out/build/mingw-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SHINKOU_BUILD_SAMPLE": "ON"
      }
    },
    {
      "name": "windows-vs",
      "displayName": "Visual Studio x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/vs",
      "cacheVariables": {
        "SHINKOU_BUILD_SAMPLE": "ON"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (platform layer)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SHINKOU_BUILD_SAMPLE": "OFF",
        "SHINKOU_BUILD_EDITOR": "OFF",
        "SHINKOU_BUILD_PHYSICS_VISUALIZER": "OFF",
        "SHINKOU_BUILD_SHADER_SCENE_TEST": "OFF",
        "SHINKOU_BUILD_PHYSICS_EXAMPLE": "OFF",
        "SHINKOU_BUILD_PHYSICS_PERFORMANCE_TEST": "OFF",
        "SHINKOU_BUILD_AUDIO_MIXER_TEST": "OFF",
        "SHINKOU_ENABLE_SDL3_INPUT": "OFF",
        "SHINKOU_ENABLE_IMGUI": "OFF",
        "SHINKOU_ENABLE_MINIAUDIO": "OFF",
        "SHINKOU_ENABLE_PHYSX": "OFF",
        "SHINKOU_ENABLE_LUA": "OFF",
        "SHINKOU_ENABLE_PYTHON": "OFF",
        "SHINKOU_ENABLE_CSHARP": "OFF",
        "SHINKOU_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug (platform layer)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/macos-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SHINKOU_BUILD_SAMPLE": "OFF",
        "SHINKOU_BUILD_EDITOR": "OFF",
        "SHINKOU_BUILD_PHYSICS_VISUALIZER": "OFF",
        "SHINKOU_BUILD_SHADER_SCENE_TEST": "OFF",
        "SHINKOU_BUILD_PHYSICS_EXAMPLE": "OFF",
        "SHINKOU_BUILD_PHYSICS_PERFORMANCE_TEST": "OFF",
        "SHINKOU_BUILD_AUDIO_MIXER_TEST": "OFF",
        "SHINKOU_ENABLE_SDL3_INPUT": "OFF",
        "SHINKOU_ENABLE_IMGUI": "OFF",
        "SHINKOU_ENABLE_MINIAUDIO": "OFF",
        "SHINKOU_ENABLE_PHYSX": "OFF",
        "SHINKOU_ENABLE_LUA": "OFF",
        "SHINKOU_ENABLE_PYTHON": "OFF",
        "SHINKOU_ENABLE_CSHARP": "OFF",
        "SHINKOU_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-debug",
      "configurePreset": "mingw-debug"
    },
    {
      "name": "windows-vs-debug",
      "configurePreset": "windows-vs",
      "configuration": "Debug"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug"
    }
  ]
}
