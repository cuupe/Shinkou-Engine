<Window x:Class="ShinkouUI.Studio.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShinkouUI.Studio.Wpf"
        xmlns:p="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        Title="ShinkouUI Style Studio"
        Width="1400" Height="860" MinWidth="1080" MinHeight="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#F5F5F7" p:Freeze="False"/>
    <SolidColorBrush x:Key="ToolbarBrush" Color="#FAFAFB" p:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F0F1F3" p:Freeze="False"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" p:Freeze="False"/>
    <SolidColorBrush x:Key="CanvasBrush" Color="#EBECEF" p:Freeze="False"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D9DCE2" p:Freeze="False"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F" p:Freeze="False"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#86868B" p:Freeze="False"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#007AFF" p:Freeze="False"/>
    <Style x:Key="ToolbarButton" TargetType="Button">
      <Setter Property="MinWidth" Value="32"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E6E7EA"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.62"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AccentButton" BasedOn="{StaticResource ToolbarButton}" TargetType="Button"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="13,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.68"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="EditorTextBox" TargetType="TextBox">
      <Setter Property="MinHeight" Value="31"/><Setter Property="Padding" Value="9,5"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="#F8F8FA"/><Setter Property="BorderBrush" Value="#D9DCE2"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="EditorComboItem" TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="9,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemChrome" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6" ClipToBounds="True"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#E7F0FC"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#DDEBFA"/><Setter Property="Foreground" Value="#0066CC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="EditorCombo" TargetType="ComboBox">
      <Setter Property="Height" Value="31"/><Setter Property="Padding" Value="9,0"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="#F8F8FA"/><Setter Property="BorderBrush" Value="#D9DCE2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="ItemContainerStyle" Value="{StaticResource EditorComboItem}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><Grid><TextBlock Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectionBoxItem}" TextTrimming="CharacterEllipsis" MaxWidth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ActualWidth}"/><ToggleButton x:Name="DropDownToggle" Width="28" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center"/></ToggleButton></Grid></Border><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" StaysOpen="False"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ActualWidth}" MaxWidth="360" MaxHeight="320"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B7C8DD"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="InspectorLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style x:Key="StyleListItem" TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemChrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#E4E5E8"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#0066CC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Border x:Name="RootFrame" Margin="14" Background="{StaticResource WindowBrush}" BorderBrush="#D7D9DE" BorderThickness="1" CornerRadius="18">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
      <Border x:Name="ToolbarFrame" Grid.Row="0" Background="{StaticResource ToolbarBrush}" CornerRadius="18,18,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="18,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"><Button Width="13" Height="13" Margin="0,0,8,0" Background="#FF5F57" BorderThickness="0" Click="Close_Click"/><Button Width="13" Height="13" Margin="0,0,8,0" Background="#FFBD2E" BorderThickness="0" Click="Minimize_Click"/><Button Width="13" Height="13" Background="#28C840" BorderThickness="0" Click="Maximize_Click"/></StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><TextBlock x:Name="DocumentTitleText" Text="ShinkouUI Style Studio" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="Style Studio · 控件样式设计" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource ToolbarButton}" Content="↶" ToolTip="撤销 Ctrl+Z" Click="Undo_OnClick"/><Button Style="{StaticResource ToolbarButton}" Content="↷" ToolTip="重做 Ctrl+Y" Click="Redo_OnClick"/><ComboBox x:Name="ThemeBox" Width="116" Style="{StaticResource EditorCombo}" SelectionChanged="Theme_OnChanged" Margin="1,0,6,0"><ComboBoxItem Content="浅色" Tag="light" IsSelected="True"/><ComboBoxItem Content="深色" Tag="dark"/></ComboBox><Button Style="{StaticResource ToolbarButton}" Content="导入 XML" Click="Load_OnClick"/><Button Style="{StaticResource AccentButton}" Content="保存 XML" Click="Save_OnClick" Margin="1,0,0,0"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
        <Border x:Name="SidebarFrame" Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="14,18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0" Margin="4,0,4,18"><TextBlock Text="样式资源" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="为同一控件维护多个变体" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><DockPanel Grid.Row="1" Margin="0,0,0,10"><ComboBox x:Name="NewStyleTypeBox" Style="{StaticResource EditorCombo}" SelectedIndex="0"><ComboBoxItem Content="button"/><ComboBoxItem Content="textbox"/><ComboBoxItem Content="checkbox"/><ComboBoxItem Content="slider"/><ComboBoxItem Content="progress"/><ComboBoxItem Content="panel"/><ComboBoxItem Content="richtextbox"/><ComboBoxItem Content="image"/><ComboBoxItem Content="video"/><ComboBoxItem Content="audio"/></ComboBox><Button Style="{StaticResource AccentButton}" Content="＋" ToolTip="新建样式变体" Click="NewStyle_OnClick" Margin="7,0,0,0" Padding="10,4"/></DockPanel><ListBox x:Name="StyleList" Grid.Row="2" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource StyleListItem}" DisplayMemberPath="DisplayName" SelectionChanged="StyleList_OnChanged"/><StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0"><Button Style="{StaticResource ToolbarButton}" Content="复制变体" Click="DuplicateStyle_OnClick" Padding="8,4"/><Button Style="{StaticResource ToolbarButton}" Content="删除" Click="DeleteStyle_OnClick" Padding="8,4" Margin="0"/></StackPanel></Grid></Border>
        <Border Grid.Column="1" Background="{StaticResource LineBrush}"/>
        <Border Grid.Column="2" Background="{StaticResource CanvasBrush}" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="2,0,2,18"><StackPanel><TextBlock Text="预览画布" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock x:Name="PreviewCaption" Text="button / primary" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="状态" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,7,0"/><ComboBox x:Name="PreviewStateBox" Width="108" Style="{StaticResource EditorCombo}" SelectionChanged="PreviewState_OnChanged"><ComboBoxItem Content="Normal" Tag="normal" IsSelected="True"/><ComboBoxItem Content="Hover" Tag="hover"/><ComboBoxItem Content="Pressed" Tag="pressed"/><ComboBoxItem Content="Disabled" Tag="disabled"/></ComboBox></StackPanel></Grid><Border Grid.Row="1" x:Name="PreviewSurface" Background="#E6E7EA" BorderBrush="#D4D7DD" BorderThickness="1" CornerRadius="12" Padding="28"><Grid x:Name="PreviewHost" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border><Grid Grid.Row="2" Margin="2,14,2,0"><TextBlock Text="当前只预览选中的样式变体；状态与动画均可单独检查。" FontSize="10" Foreground="{StaticResource MutedBrush}"/><Button x:Name="PlayAnimationButton" Content="播放动画" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Right" Click="PlayAnimation_OnClick" Padding="10,4"/></Grid></Grid></Border>
        <Border Grid.Column="3" Background="{StaticResource LineBrush}"/>
        <Border x:Name="InspectorFrame" Grid.Column="4" Background="{StaticResource SurfaceBrush}" Padding="18,20,18,12"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="样式检查器" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock x:Name="InspectorCaption" Text="button / primary" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20"/><TextBlock Text="基础外观" Style="{StaticResource SectionTitle}"/><TextBlock Text="变体名称" Style="{StaticResource InspectorLabel}"/><TextBox x:Name="VariantNameBox" Style="{StaticResource EditorTextBox}" TextChanged="StyleValue_OnChanged" Margin="0,0,0,12"/><TextBlock Text="背景色" Style="{StaticResource InspectorLabel}"/><local:ColorPickerControl x:Name="BackgroundPicker" Label="背景色" ColorChanged="ColorPicker_OnChanged" Margin="0,0,0,9"/><TextBlock Text="文字色" Style="{StaticResource InspectorLabel}"/><local:ColorPickerControl x:Name="ForegroundPicker" Label="文字色" ColorChanged="ColorPicker_OnChanged" Margin="0,0,0,9"/><TextBlock Text="边框色" Style="{StaticResource InspectorLabel}"/><local:ColorPickerControl x:Name="BorderPicker" Label="边框色" ColorChanged="ColorPicker_OnChanged" Margin="0,0,0,9"/><TextBlock Text="Hover 背景" Style="{StaticResource InspectorLabel}"/><local:ColorPickerControl x:Name="HoverPicker" Label="Hover 背景" ColorChanged="ColorPicker_OnChanged" Margin="0,0,0,9"/><TextBlock Text="Pressed 背景" Style="{StaticResource InspectorLabel}"/><local:ColorPickerControl x:Name="PressedPicker" Label="Pressed 背景" ColorChanged="ColorPicker_OnChanged" Margin="0,0,0,12"/><Separator Background="{StaticResource LineBrush}" Margin="0,0,0,16"/><TextBlock Text="尺寸与字体" Style="{StaticResource SectionTitle}"/><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="圆角" Style="{StaticResource InspectorLabel}"/><Slider x:Name="RadiusSlider" Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleValue_OnChanged" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="RadiusValue" Text="6 px" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="内边距" Style="{StaticResource InspectorLabel}"/><Slider x:Name="PaddingSlider" Minimum="0" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleValue_OnChanged" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="PaddingValue" Text="12 px" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel></Grid><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="字体" Style="{StaticResource InspectorLabel}"/><ComboBox x:Name="FontFamilyBox" Style="{StaticResource EditorCombo}" SelectionChanged="StyleValue_OnChanged"><ComboBoxItem Content="Microsoft YaHei"/><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="PingFang SC"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="字号" Style="{StaticResource InspectorLabel}"/><Slider x:Name="FontSizeSlider" Minimum="10" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleValue_OnChanged" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="FontSizeValue" Text="14 px" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel></Grid><TextBlock Text="字重" Style="{StaticResource InspectorLabel}"/><ComboBox x:Name="FontWeightBox" Style="{StaticResource EditorCombo}" SelectionChanged="StyleValue_OnChanged" Margin="0,0,0,12"><ComboBoxItem Content="Regular"/><ComboBoxItem Content="SemiBold"/><ComboBoxItem Content="Bold"/></ComboBox><StackPanel Orientation="Horizontal" Margin="0,0,0,14"><CheckBox x:Name="ShadowCheck" Content="轻量阴影" Foreground="{StaticResource TextBrush}" FontSize="11" Checked="StyleValue_OnChanged" Unchecked="StyleValue_OnChanged" Margin="0,0,18,0"/><CheckBox x:Name="ReduceMotionCheck" Content="减少动画" Foreground="{StaticResource TextBrush}" FontSize="11" Checked="StyleValue_OnChanged" Unchecked="StyleValue_OnChanged"/></StackPanel><Separator Background="{StaticResource LineBrush}" Margin="0,0,0,16"/><TextBlock Text="动画" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="AnimationEnabledCheck" Content="启用状态动画" Foreground="{StaticResource TextBrush}" FontSize="11" Checked="AnimationValue_OnChanged" Unchecked="AnimationValue_OnChanged" Margin="0,0,0,12"/><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="持续时间" Style="{StaticResource InspectorLabel}"/><Slider x:Name="AnimationDurationSlider" Minimum="0" Maximum="1600" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="AnimationValue_OnChanged" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="AnimationDurationValue" Text="180 ms" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="延迟" Style="{StaticResource InspectorLabel}"/><Slider x:Name="AnimationDelaySlider" Minimum="0" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="AnimationValue_OnChanged" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="AnimationDelayValue" Text="0 ms" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel></Grid><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="缓动" Style="{StaticResource InspectorLabel}"/><ComboBox x:Name="AnimationEasingBox" Style="{StaticResource EditorCombo}" SelectionChanged="AnimationValue_OnChanged"><ComboBoxItem Content="Linear" Tag="linear"/><ComboBoxItem Content="EaseOut" Tag="ease-out"/><ComboBoxItem Content="EaseInOut" Tag="ease-in-out"/><ComboBoxItem Content="Cubic Bezier" Tag="cubic-bezier"/><ComboBoxItem Content="Spring" Tag="spring"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="循环" Style="{StaticResource InspectorLabel}"/><ComboBox x:Name="AnimationRepeatBox" Style="{StaticResource EditorCombo}" SelectionChanged="AnimationValue_OnChanged"><ComboBoxItem Content="一次" Tag="once"/><ComboBoxItem Content="循环" Tag="loop"/><ComboBoxItem Content="往返" Tag="ping-pong"/></ComboBox></StackPanel></Grid><TextBlock Text="Cubic Bezier 控制点" Style="{StaticResource InspectorLabel}"/><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="BezierP1XBox" Grid.Column="0" Style="{StaticResource EditorTextBox}" TextChanged="AnimationValue_OnChanged"/><TextBox x:Name="BezierP1YBox" Grid.Column="2" Style="{StaticResource EditorTextBox}" TextChanged="AnimationValue_OnChanged"/><TextBox x:Name="BezierP2XBox" Grid.Column="4" Style="{StaticResource EditorTextBox}" TextChanged="AnimationValue_OnChanged"/><TextBox x:Name="BezierP2YBox" Grid.Column="6" Style="{StaticResource EditorTextBox}" TextChanged="AnimationValue_OnChanged"/></Grid><TextBlock Text="触发状态" Style="{StaticResource InspectorLabel}"/><WrapPanel Margin="0,0,0,12"><CheckBox x:Name="TriggerHoverCheck" Content="Hover" Foreground="{StaticResource TextBrush}" FontSize="11" Checked="AnimationValue_OnChanged" Unchecked="AnimationValue_OnChanged" Margin="0,0,14,5"/><CheckBox x:Name="TriggerPressedCheck" Content="Pressed" Foreground="{StaticResource TextBrush}" FontSize="11" Checked="AnimationValue_OnChanged" Unchecked="AnimationValue_OnChanged" Margin="0,0,14,5"/><CheckBox x:Name="TriggerFocusCheck" Content="Focus" Foreground="{StaticResource TextBrush}" FontSize="11" Checked="AnimationValue_OnChanged" Unchecked="AnimationValue_OnChanged" Margin="0,0,14,5"/><CheckBox x:Name="TriggerDisabledCheck" Content="Disabled" Foreground="{StaticResource TextBrush}" FontSize="11" Checked="AnimationValue_OnChanged" Unchecked="AnimationValue_OnChanged" Margin="0,0,14,5"/></WrapPanel><Button Content="播放当前动画" Style="{StaticResource AccentButton}" Click="PlayAnimation_OnClick" Margin="0,0,0,10"/><TextBlock Text="动画配置独立保存，不会污染基础外观属性。" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/></StackPanel></ScrollViewer></Border>
      </Grid>
      <Border x:Name="FooterFrame" Grid.Row="2" Background="#F0F1F3" CornerRadius="0,0,18,18" Padding="18,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#34C759" Margin="0,0,7,0"/><TextBlock x:Name="StatusText" Text="样式编辑器已就绪" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel><TextBlock Text="XML · style variants · Microsoft YaHei" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedBrush}"/></Grid></Border>
    </Grid>
  </Border>
</Window>
