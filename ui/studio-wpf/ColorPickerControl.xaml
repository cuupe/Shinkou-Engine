<UserControl x:Class="ShinkouUI.Studio.Wpf.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="168" Height="34">
  <UserControl.Resources>
    <LinearGradientBrush x:Key="WhiteGradient" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FFFFFFFF" Offset="0"/>
      <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BlackGradient" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#00000000" Offset="0"/>
      <GradientStop Color="#FF000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HueGradient" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FFFF0000" Offset="0"/>
      <GradientStop Color="#FFFFFF00" Offset="0.1667"/>
      <GradientStop Color="#FF00FF00" Offset="0.3333"/>
      <GradientStop Color="#FF00FFFF" Offset="0.5"/>
      <GradientStop Color="#FF0000FF" Offset="0.6667"/>
      <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
      <GradientStop Color="#FFFF0000" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="PresetButton" TargetType="Button">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#D8DCE3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Border x:Name="SwatchButton" Background="#F5F6F8" BorderBrush="#D9DDE4" BorderThickness="1" CornerRadius="7" Padding="7,4" MouseLeftButtonDown="SwatchButton_OnMouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Swatch" Grid.Column="0" Width="22" Height="22" CornerRadius="5" BorderBrush="#C9CED7" BorderThickness="1"/>
        <TextBlock Grid.Column="2" x:Name="ValueText" VerticalAlignment="Center" FontSize="11" Foreground="#424853" Text="#FFFFFFFF"/>
      </Grid>
    </Border>
    <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=SwatchButton}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" Closed="PickerPopup_OnClosed">
      <Border x:Name="PopupFrame" Width="292" Background="#FFFFFF" BorderBrush="#D9DDE4" BorderThickness="1" CornerRadius="13" Padding="14" Margin="0,8,0,0">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <TextBlock x:Name="LabelText" Text="颜色" FontSize="12" FontWeight="SemiBold" Foreground="#20242B"/>
            <TextBlock Text="色盘 / 色相滑轮" HorizontalAlignment="Right" Margin="0,0,25,0" FontSize="10" Foreground="#8A909A"/>
            <Button x:Name="ClosePickerButton" Content="×" HorizontalAlignment="Right" Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#8A909A" Click="ClosePicker_OnClick"/>
          </Grid>
          <Grid x:Name="SvCanvas" Height="164" ClipToBounds="True" SizeChanged="SvCanvas_OnSizeChanged" MouseLeftButtonDown="SvCanvas_OnMouseLeftButtonDown" MouseMove="SvCanvas_OnMouseMove" MouseLeftButtonUp="SvCanvas_OnMouseLeftButtonUp">
            <Border x:Name="HueBase" Background="#FFFF0000" CornerRadius="8"/>
            <Rectangle Fill="{StaticResource WhiteGradient}"/>
            <Rectangle Fill="{StaticResource BlackGradient}"/>
            <Ellipse x:Name="SvMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent" IsHitTestVisible="False"/>
          </Grid>
          <TextBlock Text="色相滑轮" FontSize="10" Foreground="#8A909A" Margin="0,12,0,5"/>
          <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Value="0" Height="18" Background="{StaticResource HueGradient}" Foreground="Transparent" ValueChanged="HueSlider_OnValueChanged"/>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="HEX / ARGB" FontSize="10" Foreground="#8A909A" Margin="0,0,0,4"/>
              <TextBox x:Name="HexBox" Height="30" Padding="8,4" BorderBrush="#D9DDE4" Background="#F7F8FA" Text="#FFFFFFFF" TextChanged="HexBox_OnTextChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Alpha" FontSize="10" Foreground="#8A909A" Margin="0,0,0,4"/>
              <TextBox x:Name="AlphaBox" Height="30" Padding="8,4" BorderBrush="#D9DDE4" Background="#F7F8FA" Text="255" TextChanged="AlphaBox_OnTextChanged"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="常用颜色" FontSize="10" Foreground="#8A909A" Margin="0,14,0,7"/>
          <WrapPanel>
            <Button Style="{StaticResource PresetButton}" Background="#FFFFFFFF" Tag="#FFFFFFFF" Click="Preset_OnClick"/>
            <Button Style="{StaticResource PresetButton}" Background="#FFF5F5F7" Tag="#FFF5F5F7" Click="Preset_OnClick"/>
            <Button Style="{StaticResource PresetButton}" Background="#FF20242B" Tag="#FF20242B" Click="Preset_OnClick"/>
            <Button Style="{StaticResource PresetButton}" Background="#FF0A84FF" Tag="#FF0A84FF" Click="Preset_OnClick"/>
            <Button Style="{StaticResource PresetButton}" Background="#FF34C759" Tag="#FF34C759" Click="Preset_OnClick"/>
            <Button Style="{StaticResource PresetButton}" Background="#FFFF9F0A" Tag="#FFFF9F0A" Click="Preset_OnClick"/>
            <Button Style="{StaticResource PresetButton}" Background="#FFFF375F" Tag="#FFFF375F" Click="Preset_OnClick"/>
            <Button Style="{StaticResource PresetButton}" Background="#FFAF52DE" Tag="#FFAF52DE" Click="Preset_OnClick"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
