set(SHINKOU_SHADER_ROOT "${SHINKOU_ENGINE_ROOT}/shaders")
file(READ "${SHINKOU_SHADER_ROOT}/Pbr.hlsli" SHINKOU_PBR_SOURCE)
file(READ "${SHINKOU_SHADER_ROOT}/BuiltinPost.hlsl" SHINKOU_POST_SOURCE)
file(READ "${SHINKOU_SHADER_ROOT}/PbrForward.hlsl" SHINKOU_FORWARD_SOURCE)
file(READ "${SHINKOU_SHADER_ROOT}/MotionVectors.hlsl" SHINKOU_MOTION_SOURCE)
file(READ "${SHINKOU_SHADER_ROOT}/Sky.hlsl" SHINKOU_SKY_SOURCE)
file(READ "${SHINKOU_SHADER_ROOT}/ExposureHistogram.hlsl" SHINKOU_HISTOGRAM_SOURCE)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${SHINKOU_SHADER_ROOT}/Pbr.hlsli" "${SHINKOU_SHADER_ROOT}/BuiltinPost.hlsl" "${SHINKOU_SHADER_ROOT}/PbrForward.hlsl" "${SHINKOU_SHADER_ROOT}/MotionVectors.hlsl" "${SHINKOU_SHADER_ROOT}/Sky.hlsl" "${SHINKOU_SHADER_ROOT}/ExposureHistogram.hlsl")
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/BuiltinShaderSources.h.in"
    "${CMAKE_CURRENT_BINARY_DIR}/generated/BuiltinShaderSources.h" @ONLY)
target_include_directories(shinkou_engine PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
set(SHINKOU_BUILTIN_SHADER_OUTPUT_DIR "${CMAKE_CURRENT_BINARY_DIR}/shinkou_builtin_shaders")
target_compile_definitions(shinkou_engine PRIVATE
    SHINKOU_BUILTIN_SHADER_OUTPUT_DIR="${SHINKOU_BUILTIN_SHADER_OUTPUT_DIR}")
if(SHINKOU_WITH_VULKAN)
    if(Vulkan_GLSLC_EXECUTABLE)
        set(SHINKOU_BUILTIN_GLSLC "${Vulkan_GLSLC_EXECUTABLE}")
    else()
        find_program(SHINKOU_BUILTIN_GLSLC NAMES glslc HINTS "$ENV{VULKAN_SDK}/Bin")
    endif()
    if(SHINKOU_BUILTIN_GLSLC)
        foreach(shader IN ITEMS VERTEX SSAO SSR TAA BLOOM BLOOM_PREFILTER BLOOM_DOWN BLOOM_UP EXPOSURE EXPOSURE_TEMPORAL EXPOSURE_HISTOGRAM EXPOSURE_HISTOGRAM_TEMPORAL HISTOGRAM_CLEAR HISTOGRAM_BUILD MOTION_BLUR TONE_MAP PRESENT PBR_VERTEX PBR_FRAGMENT SHADOW_FRAGMENT MOTION_VERTEX MOTION_FRAGMENT MOTION_BACKGROUND_VERTEX MOTION_BACKGROUND_FRAGMENT SKY_VERTEX SKY_FRAGMENT)
            if(shader MATCHES "^HISTOGRAM_")
                set(stage comp)
            elseif(shader MATCHES "VERTEX$")
                set(stage vert)
            else()
                set(stage frag)
            endif()
            set(output "${SHINKOU_BUILTIN_SHADER_OUTPUT_DIR}/${shader}.spv")
            if(shader MATCHES "^HISTOGRAM_")
                set(source "${SHINKOU_SHADER_ROOT}/ExposureHistogram.hlsl")
            elseif(shader STREQUAL "MOTION_VERTEX" OR shader STREQUAL "MOTION_FRAGMENT" OR shader MATCHES "^MOTION_BACKGROUND_")
                set(source "${SHINKOU_SHADER_ROOT}/MotionVectors.hlsl")
            elseif(shader MATCHES "^SKY_")
                set(source "${SHINKOU_SHADER_ROOT}/Sky.hlsl")
            elseif(shader MATCHES "^PBR_" OR shader STREQUAL "SHADOW_FRAGMENT")
                set(source "${SHINKOU_SHADER_ROOT}/PbrForward.hlsl")
            else()
                set(source "${SHINKOU_SHADER_ROOT}/BuiltinPost.hlsl")
            endif()
            add_custom_command(OUTPUT "${output}"
                COMMAND "${CMAKE_COMMAND}" -E make_directory "${SHINKOU_BUILTIN_SHADER_OUTPUT_DIR}"
                COMMAND "${SHINKOU_BUILTIN_GLSLC}" -x hlsl -fshader-stage=${stage}
                    -finvert-y
                    -fentry-point=main -DSHINKOU_SPIRV=1 -DSHINKOU_${shader}=1
                    -o "${output}" "${source}"
                DEPENDS "${source}" "${SHINKOU_SHADER_ROOT}/Pbr.hlsli" VERBATIM)
            list(APPEND builtin_outputs "${output}")
        endforeach()
        add_custom_target(shinkou_builtin_shaders DEPENDS ${builtin_outputs})
        add_dependencies(shinkou_engine shinkou_builtin_shaders)
    endif()
endif()
